# This file is a template for the environment variables required by the application.
# Copy this file to .env.local and fill in the values for your local development.
# IMPORTANT: .env.local should NOT be committed to version control.

# The OMDb API key is used for the fallback search functionality.
# You can get a free key from http://www.omdbapi.com/apikey.aspx
NEXT_PUBLIC_OMDB_API_KEY=your_omdb_api_key_here
